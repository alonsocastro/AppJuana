<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppJuana.Views.SplashPage"
             Title="SplashPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource CardSplashGradient}">

    <Grid RowDefinitions="*, Auto" Padding="30, 40">
        <!-- Logo y Branding Central -->
        <VerticalStackLayout Grid.Row="0" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="24">
            
            <!-- Logo Container con sombra sutil -->
            <Border BackgroundColor="Transparent"
                    Stroke="Transparent"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,8"
                            Radius="20"
                            Opacity="0.25" />
                </Border.Shadow>
                <Image Source="juana_bonita_gestion_integral_blanco.png"
                       Aspect="AspectFit"
                       HeightRequest="110"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="Logo de Juana Bonita Gestión Integral" />
            </Border>

            <!-- Spinner Minimalista -->
            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource White}"
                               HeightRequest="32"
                               WidthRequest="32"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Pie de Página: Versión y Derechos -->
        <VerticalStackLayout Grid.Row="1" 
                             HorizontalOptions="Center" 
                             Spacing="6">
            <Border BackgroundColor="#33FFFFFF"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,4"
                    HorizontalOptions="Center">
                <Label Text="Versión 1.0.0"
                       FontSize="11"
                       FontFamily="OpenSans-Semibold"
                       TextColor="{StaticResource White}"
                       HorizontalOptions="Center"/>
            </Border>
            <Label Text="Juana Bonita © Todos los derechos reservados"
                   FontSize="10"
                   TextColor="#CCFFFFFF"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>