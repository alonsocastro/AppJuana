<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppJuana.ViewModels"
             x:Class="AppJuana.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Iniciar Sesión"
             NavigationPage.HasNavigationBar="False">

    <ScrollView VerticalOptions="FillAndExpand">
        <VerticalStackLayout Spacing="0" Padding="0">

            <!-- Cabecera Decorativa Superior con Curva y Branding -->
            <Border Background="{StaticResource HeroGradient}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    Padding="24, 45, 24, 35"
                    StrokeShape="RoundRectangle 0,0,28,28">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryDark}"
                            Offset="0,6"
                            Radius="16"
                            Opacity="0.2" />
                </Border.Shadow>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Image Source="juana_bonita_gestion_integral_blanco.png"
                           HorizontalOptions="Center"
                           WidthRequest="180"
                           HeightRequest="75"
                           Aspect="AspectFit" />
                    <Label Text="Sistema de Gestión Integral"
                           FontSize="13"
                           FontFamily="OpenSans-Semibold"
                           TextColor="#EEFFFFFF"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Contenedor Principal / Tarjeta Flotante -->
            <VerticalStackLayout Padding="24, 25, 24, 30" Spacing="20" Margin="0, -10, 0, 0">

                <Border Style="{StaticResource ThemeAwareCard}"
                        Padding="24, 28"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="20">

                        <!-- Títulos -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Iniciar Sesión"
                                   FontSize="22"
                                   FontFamily="OpenSans-Semibold"
                                   Style="{StaticResource BoldPrimaryTextStyle}" />
                            <Label Text="Ingresa tus credenciales para acceder"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        </VerticalStackLayout>

                        <!-- Banner de Error (Aparece solo si hay error) -->
                        <Border IsVisible="{Binding IsErrorVisible}"
                                BackgroundColor="#FEE2E2"
                                Stroke="#EF4444"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14, 10">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="⚠"
                                       TextColor="{StaticResource Danger}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="#991B1B"
                                       FontSize="13"
                                       FontFamily="OpenSans-Semibold"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Campo: Usuario -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Usuario"
                                   FontSize="13"
                                   FontFamily="OpenSans-Semibold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Border Style="{StaticResource EntryFrame}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Source="perfil.png"
                                           HeightRequest="18"
                                           WidthRequest="18"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0"
                                           Opacity="0.6"/>
                                    <Entry Grid.Column="1"
                                           Text="{Binding Username}"
                                           Placeholder="Ingresa tu usuario"
                                           Keyboard="Email"
                                           ReturnType="Next"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo: Contraseña -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Contraseña"
                                   FontSize="13"
                                   FontFamily="OpenSans-Semibold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Border Style="{StaticResource EntryFrame}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Source="settings.png"
                                           HeightRequest="18"
                                           WidthRequest="18"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0"
                                           Opacity="0.6"/>
                                    <Entry Grid.Column="1"
                                           Text="{Binding Password}"
                                           Placeholder="••••••••"
                                           IsPassword="True"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding LoginCommand}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Spinner de Carga -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="30"
                                           WidthRequest="30"
                                           HorizontalOptions="Center" />

                        <!-- Botón de Entrar -->
                        <Button Text="Ingresar"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HeightRequest="50"
                                FontSize="16"
                                Margin="0, 8, 0, 0" />

                    </VerticalStackLayout>
                </Border>

                <!-- Pie Informativo -->
                <Label Text="Juana Bonita Móvil • Soporte y Gestión"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>